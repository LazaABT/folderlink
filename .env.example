# Folderlink settings. Every value is optional.
#
# With everything blank, Folderlink uses the free PeerJS connection service and
# needs no API keys.
#
# WARNING: GitHub Pages sites are public. Running build_config.py copies these
# values into config.js, which anyone can read. Don't put a password here that
# you also use somewhere else.

# Your own connection service, if you stop using the free PeerJS one.
# Example: PEER_HOST=folderlink.example.workers.dev
PEER_HOST=
PEER_PORT=443
PEER_PATH=/
PEER_KEY=

# STUN server used to discover network addresses. Blank uses Google's public one.
STUN_URL=

# TURN relay, for networks that block direct connections. Blank means no relay,
# so files only ever travel directly between the two computers. With a relay
# set, files can pass through it, still encrypted.
# Example: TURN_URL=turn:turn.example.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# GitHub publishing, used only by publish.py. These never go into config.js.
# Fine-grained token: https://github.com/settings/personal-access-tokens/new
#   Repository access: All repositories (the repository doesn't exist yet)
#   Permissions: Administration, Contents and Pages, all Read and write
GITHUB_TOKEN=
GITHUB_REPO=folderlink
# Set to yes to allow publishing from a public repository.
GITHUB_PUBLIC=
